<h1 class="page-title">Carrito</h1>

<% if @products.empty? %>
  <p>Tu carrito está vacío.</p>
  <p><%= link_to "Ir al catálogo", root_path, class: "btn" %></p>
<% else %>
  <% grand_total = 0 %>
  <% @products.group_by { |p| p.provider }.each do |provider, products| %>
    <% subtotal = products.sum { |p| p.price_cents * cart[p.id.to_s].to_i } %>
    <% grand_total += subtotal %>
    <section class="group">
      <h3>Proveedor: <%= provider.name %></h3>
      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th>Precio unit.</th>
            <th>Cantidad</th>
            <th>Subtotal</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "cart_line", collection: products, as: :product %>
        </tbody>
      </table>
      <p class="subtotal text-right">Subtotal <%= provider.name %>: <%= money(subtotal) %></p>
    </section>
  <% end %>

  <p class="total text-right">Total general: <%= money(grand_total) %></p>

  <%= button_to "Confirmar compra", orders_path, method: :post, class: "btn", data: { turbo_confirm: "¿Confirmar la compra?" } %>
<% end %>